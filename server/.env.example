# MongoDB connection string (local Docker or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/task-manager

# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-32-plus-characters

# How long a login token stays valid (e.g. 15m, 12h, 1d, 7d)
JWT_EXPIRES_IN=1d

PORT=5000
NODE_ENV=development
